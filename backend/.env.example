PORT=3001

# Comma-separated list of frontend origins allowed to call this API.
# Leave empty in dev (any origin). Set in production, e.g.
# CORS_ORIGIN=https://hacktoberfest-dehradun.vercel.app
CORS_ORIGIN=

# SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME="Hacktoberfest Dehradun Team"

# Public URL of the frontend, used for links inside emails.
APP_URL=http://localhost:5173
