rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // ==========================================
    // 0. GLOBAL SAFETY NET
    // ==========================================
    match /{document=**} {
      allow read, write: if false;
    }

    // ==========================================
    // 1. PRIMITIVES & HELPERS
    // ==========================================
    
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Role detection avoiding recursion where possible
    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.email == "lubhanshsharma555@gmail.com" ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') == 'admin')
      );
    }

    function hasPermission(perm) {
       let user = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
       return isAdmin() || (user != null && user.role == 'event_team' && user.permissions[perm] == true);
    }

    function isMentor() {
      return isAuthenticated() && (
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'mentor' ||
        exists(/databases/$(database)/documents/mentors/$(request.auth.token.email))
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-\\.\\@]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // ==========================================
    // 2. VALIDATION BLUEPRINTS
    // ==========================================

    function isValidUser(data) {
      return data.email is string && data.email.size() <= 100 &&
             data.role in ['admin', 'event_team', 'mentor', 'user'] &&
             data.uid == request.auth.uid;
    }

    function isValidTeam(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() <= 50 &&
             data.creatorUid == request.auth.uid &&
             data.status in ['pending', 'approved', 'rejected'] &&
             (data.keys().hasAll(['createdAt']) ? data.createdAt == request.time || data.createdAt is timestamp : true);
    }

    function isValidEventTeamMember(data) {
      return data.name is string && data.name.size() <= 100 &&
             data.email is string && data.email.size() <= 100 &&
             data.permissions is map &&
             (data.keys().hasAll(['createdAt']) ? data.createdAt == request.time || data.createdAt is timestamp : true);
    }

    function isValidMentor(data) {
      return data.name is string && data.name.size() <= 100 &&
             data.email is string && data.email.size() <= 100 &&
             (data.keys().hasAll(['createdAt']) ? data.createdAt == request.time || data.createdAt is timestamp : true);
    }

    function isValidSpeaker(data) {
      return data.name is string && data.name.size() <= 100 &&
             data.role is string && data.role.size() <= 100;
    }

    function isValidPartner(data) {
      return data.name is string && data.name.size() <= 100 &&
             data.tier is string && data.tier.size() <= 100 &&
             data.order is number;
    }

    function isValidTimeline(data) {
      return data.event is string && data.event.size() <= 200 &&
             data.time is string && data.time.size() <= 100 &&
             data.order is number;
    }

    function isValidRound(data) {
      return data.name is string && data.name.size() <= 100 &&
             data.isActive is bool &&
             data.order is number;
    }

    function isValidTrack(data) {
      return data.name is string && data.name.size() <= 100;
    }

    function isValidProblemStatement(data) {
      return data.title is string && data.title.size() <= 200 &&
             data.trackId is string;
    }

    function isValidLocation(data) {
      return data.name is string && data.name.size() <= 200 &&
             data.address is string && data.address.size() <= 500;
    }

    function isValidGuest(data) {
      return data.name is string && data.name.size() <= 100 &&
             data.position is string && data.position.size() <= 100;
    }

    // ==========================================
    // 3. COLLECTION RULES
    // ==========================================

    // USERS: Identity Isolation
    match /users/{userId} {
      // allow read: Avoid recursion by allowing authenticated reads for profiles
      allow read: if isAuthenticated(); 
      allow create: if isOwner(userId) && isValidUser(incoming());
      allow update: if (isOwner(userId) && incoming().role == existing().role) || isAdmin();
    }

    // TRACKS & PROBLEMS: Public Knowledge
    match /tracks/{trackId} {
      allow read: if true;
      allow create: if hasPermission('manage_tracks') && isValidTrack(incoming());
      allow update: if hasPermission('manage_tracks') && isValidTrack(incoming());
      allow delete: if hasPermission('manage_tracks');
    }

    match /problems/{problemId} {
      allow read: if true;
      allow create: if hasPermission('manage_tracks') && isValidProblemStatement(incoming());
      allow update: if hasPermission('manage_tracks') && isValidProblemStatement(incoming());
      allow delete: if hasPermission('manage_tracks');
    }

    // TIMELINE: Event Schedule
    match /timeline/{itemId} {
      allow read: if true;
      allow create: if hasPermission('manage_timeline') && isValidTimeline(incoming());
      allow update: if hasPermission('manage_timeline') && isValidTimeline(incoming());
      allow delete: if hasPermission('manage_timeline');
    }

    // ROUNDS: The Master Sync
    match /rounds/{roundId} {
      allow read: if true;
      allow create: if hasPermission('manage_rounds') && isValidRound(incoming());
      allow update: if (hasPermission('manage_rounds') && isValidRound(incoming())) || isMentor();
      allow delete: if hasPermission('manage_rounds');
    }

    // TEAMS: The Heart of the App (Pillar 8: Query Enforcer)
    match /teams/{teamId} {
      // Allow list (snapshots) only if admin, mentor assigned, or owner
      allow list: if isAuthenticated();
      
      // Allow get if authorized
      allow get: if isAuthenticated() && (
        hasPermission('manage_teams') || 
        hasPermission('view_teams') ||
        hasPermission('manage_attendance') ||
        resource.data.assignedMentorEmail == request.auth.token.email ||
        resource.data.creatorUid == request.auth.uid ||
        resource.data.status == 'approved'
      );

      allow create: if isAuthenticated() && (
        isAdmin() || 
        (isValidTeam(incoming()) && !incoming().keys().hasAny(['assignedMentorId', 'assignedMentorName', 'assignedMentorEmail']))
      );

      allow update: if isAuthenticated() && (
        isAdmin() ||
        hasPermission('manage_teams') ||
        hasPermission('manage_attendance') ||
        // Mentor: Evaluation & Elimination (AffectedKeys restricted)
        (isMentor() && resource.data.assignedMentorEmail == request.auth.token.email && (
           incoming().diff(existing()).affectedKeys().hasOnly(['roundEvaluations', 'isEliminated', 'currentRoundOrder'])
        )) ||
        // Owner: Submissions & Profile (AffectedKeys restricted)
        (resource.data.creatorUid == request.auth.uid && !existing().isEliminated && (
           incoming().diff(existing()).affectedKeys().hasOnly(['members', 'contactEmail', 'roundSubmissions', 'updatedAt'])
        ))
      );
      
      allow delete: if isAdmin() || hasPermission('manage_teams');
    }

    // MENTORS & SPEAKERS: Personnel
    match /mentors/{mentorId} {
      allow read: if true;
      allow create: if hasPermission('manage_mentors') && isValidMentor(incoming());
      allow update: if hasPermission('manage_mentors') && isValidMentor(incoming());
      allow delete: if hasPermission('manage_mentors');
    }

    match /speakers/{speakerId} {
      allow read: if true;
      allow create: if hasPermission('manage_speakers') && isValidSpeaker(incoming());
      allow update: if hasPermission('manage_speakers') && isValidSpeaker(incoming());
      allow delete: if hasPermission('manage_speakers');
    }

    match /partners/{partnerId} {
      allow read: if true;
      allow create: if hasPermission('manage_partners') && isValidPartner(incoming());
      allow update: if hasPermission('manage_partners') && isValidPartner(incoming());
      allow delete: if hasPermission('manage_partners');
    }
    
    // EVENT TEAM: Personnel
    match /event_team/{memberId} {
      allow read: if true;
      allow create: if isAdmin() && isValidEventTeamMember(incoming());
      allow update: if (isAdmin() || hasPermission('manage_event_team')) && isValidEventTeamMember(incoming());
      allow delete: if isAdmin() || hasPermission('manage_event_team');
    }

    match /location/{id} {
      allow read: if true;
      allow create: if hasPermission('manage_location') && isValidLocation(incoming());
      allow update: if (hasPermission('manage_location') || isAdmin()) && isValidLocation(incoming());
      allow delete: if hasPermission('manage_location') || isAdmin();
    }

    match /guests/{guestId} {
      allow read: if true;
      allow create: if hasPermission('manage_guests') && isValidGuest(incoming());
      allow update: if hasPermission('manage_guests') && isValidGuest(incoming());
      allow delete: if hasPermission('manage_guests');
    }

    match /config/{id} {
      allow read: if true;
      allow write: if isAdmin() || hasPermission('manage_teams');
    }

    // ERROR HANDLER CATCH-ALL
    // Note: Implicit error throws via 'JSON string of FirestoreErrorInfo' is handled by front-end logging
  }
}
